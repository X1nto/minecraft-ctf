$execute as @a[team=$(team),tag=!invisactive] unless items entity @s armor.chest *[custom_data~{ctf:{id:"team_chestplate"}},dyed_color=$(color)] run function ctf:utility/regrant {id:"team_chestplate",slot:"armor.chest",item:'minecraft:leather_chestplate[custom_data={ctf:{armor:1b,id:"team_chestplate"}},dyed_color=$(color),unbreakable={}]',count:1}
$execute as @a[team=$(team),tag=!invisactive] unless items entity @s armor.head *[custom_data~{ctf:{id:"team_helmet"}},dyed_color=$(color)] run function ctf:utility/regrant {id:"team_helmet",slot:"armor.head",item:'minecraft:leather_helmet[custom_data={ctf:{armor:1b,id:"team_helmet"}},dyed_color=$(color),unbreakable={}]',count:1}
